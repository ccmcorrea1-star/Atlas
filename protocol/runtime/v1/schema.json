{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ccmcorrea1-star/Atlas/protocol/runtime/v1/schema.json",
  "title": "Atlas Runtime Protocol v1",
  "description": "Mensagens JSON Lines trocadas entre o Atlas Runtime e seus clientes.",
  "oneOf": [
    { "$ref": "#/$defs/turnRequest" },
    { "$ref": "#/$defs/turnCancel" },
    { "$ref": "#/$defs/commandRequest" },
    { "$ref": "#/$defs/approvalRespond" },
    { "$ref": "#/$defs/sessionUpdated" },
    { "$ref": "#/$defs/turnStarted" },
    { "$ref": "#/$defs/contextUpdated" },
    { "$ref": "#/$defs/messageDelta" },
    { "$ref": "#/$defs/messageCompleted" },
    { "$ref": "#/$defs/reasoningStart" },
    { "$ref": "#/$defs/reasoningDelta" },
    { "$ref": "#/$defs/reasoningEnd" },
    { "$ref": "#/$defs/toolStarted" },
    { "$ref": "#/$defs/toolCompleted" },
    { "$ref": "#/$defs/executionStarted" },
    { "$ref": "#/$defs/executionOutputDelta" },
    { "$ref": "#/$defs/executionCompleted" },
    { "$ref": "#/$defs/turnCompleted" },
    { "$ref": "#/$defs/turnCancelled" },
    { "$ref": "#/$defs/commandCompleted" },
    { "$ref": "#/$defs/approvalRequested" },
    { "$ref": "#/$defs/approvalResolved" },
    { "$ref": "#/$defs/runtimeRestarting" },
    { "$ref": "#/$defs/runtimeReady" },
    { "$ref": "#/$defs/operationResuming" },
    { "$ref": "#/$defs/operationResumed" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "protocolHeader": {
      "type": "object",
      "properties": {
        "protocol": { "const": "atlas-runtime" },
        "version": { "const": 1 }
      },
      "required": ["protocol", "version"],
      "additionalProperties": true
    },
    "requestIdentity": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string", "minLength": 1 },
        "conversation_id": { "type": "string", "minLength": 1 }
      },
      "required": ["request_id", "conversation_id"]
    },
    "eventIdentity": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string", "minLength": 1 },
        "conversation_id": { "type": "string", "minLength": 1 }
      },
      "required": ["request_id", "conversation_id"]
    },
    "context": {
      "type": "object",
      "properties": {
        "used_tokens": { "type": "integer", "minimum": 0 },
        "context_window": { "type": "integer", "minimum": 1 }
      },
      "required": ["used_tokens", "context_window"],
      "additionalProperties": true
    },
    "event": {
      "allOf": [{ "$ref": "#/$defs/protocolHeader" }, { "$ref": "#/$defs/eventIdentity" }],
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "data": { "type": "object" }
      },
      "required": ["type", "data"],
      "additionalProperties": true
    },
    "turnRequest": {
      "allOf": [{ "$ref": "#/$defs/protocolHeader" }, { "$ref": "#/$defs/requestIdentity" }],
      "type": "object",
      "properties": {
        "type": { "const": "turn.request" },
        "input": { "type": "string", "minLength": 1 },
        "attachments": {
          "type": "array",
          "items": { "$ref": "#/$defs/attachment" }
        }
      },
      "required": ["type", "input"],
      "additionalProperties": true
    },
    "turnCancel": {
      "allOf": [{ "$ref": "#/$defs/protocolHeader" }, { "$ref": "#/$defs/requestIdentity" }],
      "type": "object",
      "properties": {
        "type": { "const": "turn.cancel" }
      },
      "required": ["type"],
      "additionalProperties": true
    },
    "commandRequest": {
      "allOf": [{ "$ref": "#/$defs/protocolHeader" }, { "$ref": "#/$defs/requestIdentity" }],
      "type": "object",
      "properties": {
        "type": { "const": "command.request" },
        "command": { "enum": ["new", "status", "stop"] }
      },
      "required": ["type", "command"],
      "additionalProperties": true
    },
    "approvalRespond": {
      "allOf": [{ "$ref": "#/$defs/protocolHeader" }, { "$ref": "#/$defs/requestIdentity" }],
      "type": "object",
      "properties": {
        "type": { "const": "approval.respond" },
        "approval_id": { "type": "string", "minLength": 1 },
        "approved": { "type": "boolean" },
        "comment": { "type": "string" }
      },
      "required": ["type", "approval_id", "approved"],
      "additionalProperties": true
    },
    "attachment": {
      "type": "object",
      "properties": {
        "type": { "enum": ["voice", "audio", "image", "document"] },
        "uri": { "type": "string", "minLength": 1 },
        "media_type": { "type": "string", "minLength": 1 },
        "file_name": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "source": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "required": ["type", "uri", "media_type"],
      "additionalProperties": true
    },
    "session": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "status": { "enum": ["idle", "running", "cancelled"] },
        "active_request_id": { "type": "string", "minLength": 1 }
      },
      "required": ["id", "model", "provider", "status"],
      "additionalProperties": true
    },
    "sessionUpdated": {
      "allOf": [
        { "$ref": "#/$defs/event" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "session.updated" },
            "data": {
              "type": "object",
              "properties": {
                "model": { "type": "string", "minLength": 1 },
                "provider": { "type": "string", "minLength": 1 }
              },
              "required": ["model", "provider"],
              "additionalProperties": true
            }
          },
          "required": ["type", "data"]
        }
      ]
    },
    "turnStarted": {
      "allOf": [
        { "$ref": "#/$defs/event" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "turn.started" },
            "data": { "type": "object" }
          }
        }
      ]
    },
    "contextUpdated": {
      "allOf": [
        { "$ref": "#/$defs/event" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "context.updated" },
            "data": { "$ref": "#/$defs/context" }
          }
        }
      ]
    },
    "messageDelta": {
      "allOf": [
        { "$ref": "#/$defs/event" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "message.delta" },
            "data": {
              "type": "object",
              "properties": {
                "message_id": { "type": "string", "minLength": 1 },
                "delta": { "type": "string" }
              },
              "required": ["message_id", "delta"],
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "messageCompleted": {
      "allOf": [
        { "$ref": "#/$defs/event" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "message.completed" },
            "data": {
              "type": "object",
              "properties": {
                "message_id": { "type": "string", "minLength": 1 },
                "content": { "type": "string" }
              },
              "required": ["message_id", "content"],
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "reasoningStart": {
      "allOf": [
        { "$ref": "#/$defs/event" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "reasoning-start" },
            "data": {
              "type": "object",
              "properties": {
                "reasoning_id": { "type": "string", "minLength": 1 }
              },
              "required": ["reasoning_id"],
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "reasoningDelta": {
      "allOf": [
        { "$ref": "#/$defs/event" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "reasoning-delta" },
            "data": {
              "type": "object",
              "properties": {
                "reasoning_id": { "type": "string", "minLength": 1 },
                "delta": { "type": "string" }
              },
              "required": ["reasoning_id", "delta"],
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "reasoningEnd": {
      "allOf": [
        { "$ref": "#/$defs/event" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "reasoning-end" },
            "data": {
              "type": "object",
              "properties": {
                "reasoning_id": { "type": "string", "minLength": 1 }
              },
              "required": ["reasoning_id"],
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "toolStarted": {
      "allOf": [
        { "$ref": "#/$defs/event" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "tool.started" },
            "data": {
              "type": "object",
              "properties": {
                "tool_id": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 },
                "target": { "type": "string", "minLength": 1 }
              },
              "required": ["tool_id", "name"],
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "toolCompleted": {
      "allOf": [
        { "$ref": "#/$defs/event" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "tool.completed" },
            "data": {
              "type": "object",
              "properties": {
                "tool_id": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 },
                "output": { "type": "string" }
              },
              "required": ["tool_id", "name"],
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "executionStarted": {
      "allOf": [
        { "$ref": "#/$defs/event" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "execution.started" },
            "data": {
              "type": "object",
              "properties": {
                "execution_id": { "type": "string", "minLength": 1 },
                "capability": { "const": "shell.exec" },
                "program": { "type": "string", "minLength": 1 },
                "args": { "type": "array", "items": { "type": "string" } },
                "cwd": { "type": "string" },
                "target": { "type": "string" }
              },
              "required": ["execution_id", "capability", "program", "args"],
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "executionOutputDelta": {
      "allOf": [
        { "$ref": "#/$defs/event" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "execution.output.delta" },
            "data": {
              "type": "object",
              "properties": {
                "execution_id": { "type": "string", "minLength": 1 },
                "capability": { "const": "shell.exec" },
                "channel": { "enum": ["stdout", "stderr"] },
                "delta": { "type": "string" }
              },
              "required": ["execution_id", "capability", "channel", "delta"],
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "executionCompleted": {
      "allOf": [
        { "$ref": "#/$defs/event" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "execution.completed" },
            "data": {
              "type": "object",
              "properties": {
                "execution_id": { "type": "string", "minLength": 1 },
                "capability": { "const": "shell.exec" },
                "stdout": { "type": "string" },
                "stderr": { "type": "string" },
                "exit_code": { "type": "integer" },
                "duration_ms": { "type": "integer", "minimum": 0 },
                "status": { "type": "string", "minLength": 1 }
              },
              "required": [
                "execution_id",
                "capability",
                "stdout",
                "stderr",
                "exit_code",
                "duration_ms",
                "status"
              ],
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "turnCompleted": {
      "allOf": [
        { "$ref": "#/$defs/event" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "turn.completed" },
            "data": {
              "type": "object",
              "properties": {
                "content": { "type": "string" },
                "message_id": { "type": "string", "minLength": 1 },
                "context": { "$ref": "#/$defs/context" },
                "attachments": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/attachment" }
                }
              },
              "required": ["content"],
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "turnCancelled": {
      "allOf": [
        { "$ref": "#/$defs/event" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "turn.cancelled" },
            "data": {
              "type": "object",
              "properties": {
                "content": { "type": "string" },
                "message_id": { "type": "string", "minLength": 1 }
              },
              "required": ["content"],
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "commandCompleted": {
      "allOf": [
        { "$ref": "#/$defs/event" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "command.completed" },
            "data": {
              "type": "object",
              "properties": {
                "command": { "enum": ["new", "status", "stop"] },
                "message": { "type": "string" },
                "session": { "$ref": "#/$defs/session" }
              },
              "required": ["command", "message", "session"],
              "additionalProperties": true
            }
          },
          "required": ["type", "data"]
        }
      ]
    },
    "approvalRequested": {
      "allOf": [
        { "$ref": "#/$defs/event" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "approval.requested" },
            "data": {
              "type": "object",
              "properties": {
                "approval_id": { "type": "string", "minLength": 1 },
                "tool_name": { "type": "string", "minLength": 1 },
                "reason": { "type": "string", "minLength": 1 },
                "expires_at": { "type": "string" }
              },
              "required": ["approval_id", "tool_name", "reason"],
              "additionalProperties": true
            }
          },
          "required": ["type", "data"]
        }
      ]
    },
    "approvalResolved": {
      "allOf": [
        { "$ref": "#/$defs/event" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "approval.resolved" },
            "data": {
              "type": "object",
              "properties": {
                "approval_id": { "type": "string", "minLength": 1 },
                "approved": { "type": "boolean" },
                "comment": { "type": "string" }
              },
              "required": ["approval_id", "approved"],
              "additionalProperties": true
            }
          },
          "required": ["type", "data"]
        }
      ]
    },
    "runtimeRestarting": {
      "allOf": [
        { "$ref": "#/$defs/event" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "runtime.restarting" },
            "data": {
              "type": "object",
              "properties": {
                "reason": { "enum": ["handoff", "rollback", "crash"] }
              },
              "required": ["reason"],
              "additionalProperties": true
            }
          },
          "required": ["type", "data"]
        }
      ]
    },
    "runtimeReady": {
      "allOf": [
        { "$ref": "#/$defs/event" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "runtime.ready" },
            "data": { "type": "object", "additionalProperties": true }
          },
          "required": ["type", "data"]
        }
      ]
    },
    "operationResuming": {
      "allOf": [
        { "$ref": "#/$defs/event" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "operation.resuming" },
            "data": {
              "type": "object",
              "properties": {
                "operation_id": { "type": "string", "minLength": 1 }
              },
              "required": ["operation_id"],
              "additionalProperties": true
            }
          },
          "required": ["type", "data"]
        }
      ]
    },
    "operationResumed": {
      "allOf": [
        { "$ref": "#/$defs/event" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "operation.resumed" },
            "data": {
              "type": "object",
              "properties": {
                "operation_id": { "type": "string", "minLength": 1 }
              },
              "required": ["operation_id"],
              "additionalProperties": true
            }
          },
          "required": ["type", "data"]
        }
      ]
    },
    "error": {
      "allOf": [
        { "$ref": "#/$defs/event" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "error" },
            "data": {
              "type": "object",
              "properties": {
                "code": { "type": "string", "minLength": 1 },
                "message": { "type": "string", "minLength": 1 }
              },
              "required": ["code", "message"],
              "additionalProperties": true
            }
          }
        }
      ]
    }
  }
}
