{
  "name": "atlas",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "runtime": "tsx src/runtime/server.ts",
    "telegram": "tsx clients/telegram/main.ts",
    "build": "npm run build:runtime && npm run build:web-search && npm run build:web-browser && npm run build:web-crawl && npm run build:native",
    "build:runtime": "tsc",
    "build:native": "node scripts/build-native.mjs all",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint --config config/eslint.config.mjs \"config/**/*.mjs\" \"src/**/*.ts\" \"clients/telegram/**/*.ts\" \"tests/**/*.ts\"",
    "lint:client": "cargo clippy --locked --manifest-path clients/tui/Cargo.toml --all-targets -- -D warnings",
    "lint:fix": "eslint --config config/eslint.config.mjs \"config/**/*.mjs\" \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:client": "cargo build --locked --manifest-path clients/tui/Cargo.toml",
    "sync:client": "node scripts/sync-client.mjs",
    "build:lsp": "node scripts/build-capability-runtime.mjs lsp release",
    "test:client": "cargo test --locked --manifest-path clients/tui/Cargo.toml",
    "build:web-search": "node scripts/build-web-search.mjs",
    "build:web-browser": "node scripts/build-web-tools.mjs browser",
    "build:web-crawl": "node scripts/build-web-tools.mjs crawl",
    "build:web-fetch": "node scripts/build-capability-runtime.mjs web-fetch release",
    "test:tui": "npm run test:client",
    "test:runtime": "node scripts/run-typescript-tests.mjs runtime",
    "test:telegram": "node scripts/run-typescript-tests.mjs telegram",
    "test:native": "node scripts/run-native-tests.mjs",
    "test:lsp": "cargo test --locked --manifest-path src/capabilities/tools/lsp/Cargo.toml",
    "test:web-fetch": "cargo test --locked --manifest-path src/capabilities/tools/web/fetch/Cargo.toml",
    "test:web-search": "node scripts/run-typescript-tests.mjs web-search",
    "test:web-browser": "node scripts/run-typescript-tests.mjs web-browser",
    "test:web-crawl": "node scripts/run-typescript-tests.mjs web-crawl",
    "check:tui": "npm run lint:client && npm run build:client && npm run test:tui",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "check:full": "npm run check && npm run lint:lsp && npm run lint:web-fetch && npm run build && npm test && npm run smoke && npm run check:tui",
    "lint:web-fetch": "cargo clippy --locked --manifest-path src/capabilities/tools/web/fetch/Cargo.toml --all-targets -- -D warnings",
    "lint:lsp": "cargo clippy --locked --manifest-path src/capabilities/tools/lsp/Cargo.toml --all-targets -- -D warnings",
    "smoke": "tsx src/smoke.ts",
    "bench:capabilities": "tsx scripts/benchmark-capability-bridge.ts",
    "test": "npm run test:runtime && npm run test:telegram && npm run test:native && npm run test:lsp && npm run test:web-fetch && npm run test:web-search && npm run test:web-browser && npm run test:web-crawl"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccmcorrea1-star/Atlas.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ccmcorrea1-star/Atlas/issues"
  },
  "homepage": "https://github.com/ccmcorrea1-star/Atlas#readme",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.53",
    "@ai-sdk/openai": "^4.0.66",
    "@ai-sdk/openai-compatible": "^3.0.48",
    "@openai/agents": "^0.18.0",
    "@openai/agents-extensions": "^0.18.0",
    "ai": "^7.0.99",
    "playwright-core": "1.63.0",
    "zod": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
