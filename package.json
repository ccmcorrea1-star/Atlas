{
  "name": "atlas",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "runtime": "tsx src/runtime/server.ts",
    "build": "tsc && cmake -S . -B .native-cmake && cmake --build .native-cmake && npm run build:lsp && npm run build:web-search && npm run build:web-fetch",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint --config config/eslint.config.mjs \"config/**/*.mjs\" \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:client": "cargo clippy --locked --manifest-path clients/tui/Cargo.toml --all-targets -- -D warnings",
    "lint:fix": "eslint --config config/eslint.config.mjs \"config/**/*.mjs\" \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:client": "cargo build --locked --manifest-path clients/tui/Cargo.toml",
    "build:lsp": "cargo build --locked --release --manifest-path src/capabilities/tools/lsp/Cargo.toml && node -e \"const fs=require('node:fs');const d='src/capabilities/tools/lsp/diagnostics/runtime';fs.rmSync(d,{force:true});fs.copyFileSync('src/capabilities/tools/lsp/target/release/atlas-lsp-runtime',d);fs.chmodSync(d,0o755)\"",
    "test:client": "cargo test --locked --manifest-path clients/tui/Cargo.toml",
    "build:web-search": "tsc src/capabilities/tools/web/search/search.ts --target es2022 --module nodenext --moduleResolution nodenext --strict --skipLibCheck --noEmitOnError --rootDir src/capabilities/tools/web/search --outDir .web-search-build && node -e \"const fs=require('node:fs');fs.copyFileSync('.web-search-build/search.js','src/capabilities/tools/web/search/runtime');fs.rmSync('.web-search-build',{recursive:true,force:true});fs.chmodSync('src/capabilities/tools/web/search/runtime',0o755)\"",
    "build:web-fetch": "cargo build --locked --release --manifest-path src/capabilities/tools/web/fetch/Cargo.toml && node -e \"const fs=require('node:fs');const d='src/capabilities/tools/web/fetch/runtime';fs.rmSync(d,{force:true});fs.copyFileSync('src/capabilities/tools/web/fetch/target/release/atlas-web-fetch-runtime',d);fs.chmodSync(d,0o755)\"",
    "test:lsp": "cargo test --locked --manifest-path src/capabilities/tools/lsp/Cargo.toml",
    "test:web-fetch": "cargo test --locked --manifest-path src/capabilities/tools/web/fetch/Cargo.toml",
    "lint:web-fetch": "cargo clippy --locked --manifest-path src/capabilities/tools/web/fetch/Cargo.toml --all-targets -- -D warnings",
    "lint:lsp": "cargo clippy --locked --manifest-path src/capabilities/tools/lsp/Cargo.toml --all-targets -- -D warnings",
    "smoke": "tsx src/smoke.ts",
    "bench:capabilities": "tsx scripts/benchmark-capability-bridge.ts",
    "test": "node scripts/run-native-tests.mjs && npm run test:lsp && npm run test:web-fetch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccmcorrea1-star/Atlas.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ccmcorrea1-star/Atlas/issues"
  },
  "homepage": "https://github.com/ccmcorrea1-star/Atlas#readme",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.53",
    "@ai-sdk/openai": "^4.0.66",
    "@ai-sdk/openai-compatible": "^3.0.48",
    "@openai/agents": "^0.18.0",
    "@openai/agents-extensions": "^0.18.0",
    "ai": "^7.0.99",
    "zod": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
